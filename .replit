modules = ["python-3.12", "web", "nodejs-20"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "gitFull", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "playwright-driver", "tcl", "tk", "zlib"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
GROQ_MODEL = "openai/gpt-oss-20b"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EduBac"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "navbar-browser"

[[workflows.workflow]]
name = "EduBac"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd EduBac && python manage.py migrate --noinput && python manage.py load_curriculum && python manage.py runserver 0.0.0.0:5000"
waitForPort = 5000

[[workflows.workflow]]
name = "navbar-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python EduBac/manage.py test browser_tests --settings=browser_tests.settings --noinput"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
