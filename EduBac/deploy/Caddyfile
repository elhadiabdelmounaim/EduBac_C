# Caddy : HTTPS automatique (Let's Encrypt), fichiers statiques, proxy HTTP + WebSocket vers Daphne.
{$SITE_DOMAIN} {
	encode gzip
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Les médias privés (pièces jointes, PDF) passent par Django, qui vérifie les droits.
	reverse_proxy web:8000
}
