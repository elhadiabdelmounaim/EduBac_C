DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# AI providers (serveur uniquement — ne jamais exposer au frontend)
# ---------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=groq

GROQ_API_KEY=
# Llama 3.1 8B Instant and Llama 3.3 70B are unavailable on Groq free and
# developer tiers. gpt-oss-20b is the replacement. Reasoning effort stays low
# because those tokens count toward tokens-per-minute.
# Quality alternatives: qwen/qwen3.8-27b, openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_CALLS_PER_MIN=30
AI_MAX_CALLS_PER_MIN=30
# Extra diversity call to the model. Local checks stay on either way.
QUIZ_SEMANTIC_CHECK_ENABLED=false
# Characters of lesson text sent with a quiz prompt. Summary is kept first.
QUIZ_LESSON_CONTEXT_CHARS=5000
# Requested completion tokens plus the prompt must stay within this Groq budget.
QUIZ_GROQ_REQUEST_TOKEN_BUDGET=7500
QUIZ_MAX_QUESTIONS=10

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

XAI_API_KEY=
XAI_MODEL=grok-3-mini

# E-mail (console = affiche dans le terminal ; smtp = envoi réel)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EduBac <noreply@edubac.ma>
EMAIL_NOTIFICATIONS_ENABLED=True

# Production e-mail Gmail (exemple) :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=votre@gmail.com
# EMAIL_HOST_PASSWORD=mot_de_passe_application

# Code secret pour créer un compte enseignant (inscription)
TEACHER_REGISTER_CODE=edubac-prof-2026
